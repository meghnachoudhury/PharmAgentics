# Spec Kit tracks managed files by SHA-256. Keep them LF on every OS so
# Windows checkouts (core.autocrlf=true) do not show them as modified.
.specify/** text eol=lf
.claude/skills/** text eol=lf
.agents/** text eol=lf
specs/** text eol=lf
*.md text eol=lf
deploy/agent/entrypoint.sh text eol=lf
# The data version is a hash of the exact CSV bytes (load_duckdb.file_sha256), line endings included, so every
# checkout must have the same bytes: LF on every OS. Without this, Windows (core.autocrlf=true) computes a
# different data version from Linux, CI and the Docker images, and agent briefs are refused on a mismatch.
data/agent_visible/*.csv text eol=lf
